{
  "manifest_version": 3,
  "name": "Anjadhe Reader",
  "version": "0.1.0",
  "description": "Read the article you are on in Anjadhe on this Mac: fetched and summarized by your own AI, and when the page will not load, coverage from other sources instead.",
  "permissions": ["activeTab", "contextMenus"],
  "action": {
    "default_title": "Read in Anjadhe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Read the current page in Anjadhe"
    }
  }
}
